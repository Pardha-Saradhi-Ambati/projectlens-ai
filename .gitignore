# ==========================================
# ProjectLens AI — Root .gitignore
# ==========================================

# 1. Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# 2. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
jspm_packages/
.pnp
.pnp.js

# 3. Python Virtual Environments & Packages
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
lib/
include/

# 4. Python Bytecode, Caches & Logs
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.log

# 5. Build & Distribution Directories
dist/
dist-ssr/
build/
*.egg-info/
.eggs/
.vite/
frontend/dist/

# 6. Temporary Files & Local App Data
.temp/
backend/.temp/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# 7. IDE & Editor Configurations
.vscode/
.idea/
.gemini/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini

# 8. Testing & Coverage Outputs
coverage/
.nyc_output/
