# Base URL for the deployed FastAPI backend API.
# In local development, leave this empty to use Vite's dev proxy (/api).
# For production (e.g. Vercel, Netlify), set this to your deployed backend URL:
# Example: VITE_API_BASE_URL=https://projectlens-api.onrender.com
VITE_API_BASE_URL=
